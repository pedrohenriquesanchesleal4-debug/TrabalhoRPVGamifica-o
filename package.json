{
  "name": "safra-df",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "smoke": "node --env-file=.env.local scripts/smoke-live.mjs",
    "embed:corpus": "node scripts/embed-corpus.mjs",
    "browser-check": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "description": "Jogo web multiplayer educacional sobre agricultura familiar no Distrito Federal, usado como atividade diagnostica em sala.",
  "engines": {
    "node": ">=20.9.0"
  }
}
